{
  "name": "vivera",
  "version": "1.0.0",
  "description": "Ultimate All-in-One AI Coding Agent Skill Pipeline",
  "type": "module",
  "author": "Iwan Kurniawan",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/belajarcarabelajar/vivera.git"
  },
  "scripts": {
    "render-diagrams": "bash scripts/render-diagrams.sh",
    "validate": "bun scripts/validate-skill.mjs",
    "test": "bun test --timeout 30000 scripts/",
    "plan:check": "bun scripts/ultra-plan-runner.mjs",
    "contract:check": "bun scripts/check-runner-contract.mjs",
    "copy:check": "bun scripts/check-copy-rules.mjs",
    "design:check": "bun scripts/check-design-tells.mjs",
    "dups:check": "bun scripts/check-duplicate-defs.mjs",
    "size:check": "bun scripts/check-file-size.mjs",
    "audit:skipif": "bun scripts/skipif-registry-audit.mjs",
    "plan:run": "bun scripts/ultra-plan-runner.mjs --execute",
    "pr:claim": "bun scripts/pr-registry.mjs claim",
    "pr:order": "bun scripts/pr-registry.mjs order",
    "pr:status": "bun scripts/pr-registry.mjs status",
    "issue:sync": "bun scripts/plan-issue-sync.mjs",
    "issue:check": "bun scripts/plan-issue-sync.mjs --check",
    "issue:status": "bun scripts/plan-issue-sync.mjs --status",
    "snippets:status": "bun scripts/sync-snippets.mjs --status",
    "snippets:check": "bun scripts/sync-snippets.mjs --check",
    "snippets:push": "bun scripts/sync-snippets.mjs --push",
    "mirror:publish": "bun scripts/plan-publish.mjs",
    "mirror:check": "bun scripts/plan-publish.mjs --check --all",
    "mirror:status": "bun scripts/plan-publish.mjs --status",
    "graphify:sync": "bun scripts/graphify-sync.mjs",
    "skills:link": "bun scripts/install-skill-links.mjs",
    "skills:check": "bun scripts/install-skill-links.mjs --check",
    "agents:check": "bun scripts/validate-agents.mjs && bun scripts/gen-sprite-agents.mjs --check",
    "agents:gen": "bun scripts/gen-sprite-agents.mjs",
    "graphify:check": "bun scripts/graphify-sync.mjs --check",
    "graphify:register": "bun scripts/graphify-register.mjs",
    "graphify:audit": "bun scripts/graphify-audit.mjs",
    "graphify:hooks": "bun scripts/graphify-hooks-install.mjs",
    "ci:targeted": "bun scripts/ci-targeted.mjs",
    "ci": "bash scripts/render-diagrams.sh && bun scripts/validate-skill.mjs && bun scripts/validate-agents.mjs && bun scripts/gen-sprite-agents.mjs --check && bun scripts/check-file-size.mjs --all && bun test --timeout 30000 scripts/ && bun scripts/sync-snippets.mjs --check"
  },
  "devDependencies": {
    "@mermaid-js/mermaid-cli": "^12.0.0",
    "yaml": "^2.9.1"
  },
  "engines": {
    "bun": ">=1.1.0",
    "node": ">=22.13.0"
  },
  "packageManager": "bun@1.4.2",
  "license": "MIT"
}
