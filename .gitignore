.DS_Store
Thumbs.db
*~
*.swp
*.swo
node_modules/

# Rendered SVGs are build artifacts, not source. The README hero is the one
# exception: GitHub does not render Mermaid in raw HTML, so the lifecycle image
# has to exist as a file. CI re-renders and fails if it drifts from the source.
diagrams/*
!diagrams/lifecycle.svg
!diagrams/lifecycle-dark.svg

# Staging dir render-diagrams.sh creates while mmdc runs. It is recreated on
# every CI run, and without this it shows up as untracked noise in `git status`
# every time, which trains you to ignore untracked files.
.mermaid-tmp/

# Session coordination state for the PR delivery stage. This is per-machine live
# state, not source: it records which branch and worktree each running session
# holds right now, so twenty concurrent sessions can find each other. Committing
# it would merge twenty machines' in-flight sessions into one file and guarantee
# a conflict on the next claim. Losing it costs a re-claim, not history.
pr.registry.json

# Recorded plan -> GitHub issue links for THIS repository, same reasoning as
# pr.registry.json above: live coordination state that changes on every sync.
# The mapping itself (project -> owner/repo) lives in plan.issues.json, which IS
# committed, because it is configuration rather than state.
plan.issues.local.json

# -------------------------------------------------------
# graphify build output (knowledge graph artifacts)
# -------------------------------------------------------
# graphify-out/ is regenerated by extraction and holds absolute
# machine-local paths (.graphify_root, .graphify_python) and a
# multi-hundred-MB cache/. Committing it would fight git.
# To SHARE a graph with a teammate, force-add only the queryable
# products:  git add -f graphify-out/graph.json
# Never force-add the cache or the two path-marker files.
graphify-out/

# Machine-local private state, kept out of the public tree: vault paths, plan
# drafts and local sync config that describe this machine only.
vault-index/
spike-out/
docs/code-plan/
plans.publish.json
plan.issues.json
local.config.json
