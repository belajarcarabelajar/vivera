# A Windows clone with core.autocrlf would otherwise turn every installer script into CRLF, and
# `set -euo pipefail` followed by a carriage return is not a valid bash command.
*.sh text eol=lf
scripts/install/tiers.tsv text eol=lf
# .githooks/pre-commit is a bash script without a .sh suffix, so *.sh does not cover it.
.githooks/* text eol=lf
# The website is not part of the release archive.
apps/ export-ignore
# Not written by an agent, so the file size gate skips them: lockfiles, generated output, vendored code.
*.lock -size-gate
diagrams/*.svg -size-gate
examples/graph-viewer-demo.html -size-gate
.claude/agents/*.md -size-gate
.opencode/skills/graphify/** -size-gate
.opencode/plugins/graphify.js -size-gate
