{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Agent|Task",
        "hooks": [
          {
            "type": "command",
            "command": "\"$(command -v bun || echo \"$HOME/.bun/bin/bun\")\" \"${CLAUDE_PLUGIN_ROOT}/hooks/route.ts\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
